        "max_hops",
        "max_cross_domains",
        "max_cross_edges",
        "max_evidence_refs",
        "reasoning_depth",
        "device_hydration",
        "execution_depth",
        "max_compute_ms",
        "max_ops_per_second",
        "max_transfer_bytes"
