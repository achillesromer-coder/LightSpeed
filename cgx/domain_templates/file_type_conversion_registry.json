{
  "schema": "CGX-FILE-TYPE-CONVERSION-REGISTRY/0.1",
  "status": "active",
  "source_runtime": "S92 CGX runtime type profiles + current capability policy",
  "types": [
    {
      "id": "text/plain",
      "extensions": [
        "txt"
      ],
      "ingest": "exact-bytes+text",
      "r0": true,
      "r1": "text structure",
      "adapter": "text-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "text/markdown",
      "extensions": [
        "md"
      ],
      "ingest": "exact-bytes+markup",
      "r0": true,
      "r1": "markup/text structure",
      "adapter": "text-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "application/json",
      "extensions": [
        "json"
      ],
      "ingest": "exact-bytes+tree",
      "r0": true,
      "r1": "JSON tree",
      "adapter": "json-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "text/csv",
      "extensions": [
        "csv"
      ],
      "ingest": "exact-bytes+table",
      "r0": true,
      "r1": "table",
      "adapter": "csv-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "application/pdf",
      "extensions": [
        "pdf"
      ],
      "ingest": "exact-bytes+pdf-semantic",
      "r0": true,
      "r1": "bounded PDF semantic extraction",
      "adapter": "pdf-pypdf-v0.1",
      "status": "capability-gated"
    },
    {
      "id": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "extensions": [
        "xlsx"
      ],
      "ingest": "exact-bytes+ooxml-semantic",
      "r0": true,
      "r1": "OOXML workbook/sheet/cell/table structure",
      "adapter": "xlsx-ooxml-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "extensions": [
        "docx"
      ],
      "ingest": "exact-bytes+ooxml-semantic",
      "r0": true,
      "r1": "OOXML document structure",
      "adapter": "docx-ooxml-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "text/html",
      "extensions": [
        "html",
        "htm"
      ],
      "ingest": "exact-bytes+html-semantic-no-execution",
      "r0": true,
      "r1": "HTML DOM/text without execution",
      "adapter": "html-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "application/x-cgx",
      "extensions": [
        "cgx"
      ],
      "ingest": "verified CGX filespace/carrier",
      "r0": true,
      "r1": "native CGX semantic state",
      "handler": "cgx-host-v0.1",
      "status": "supported-preferred"
    },
    {
      "id": "model/step",
      "extensions": [
        "step",
        "stp"
      ],
      "ingest": "exact bytes + bounded ISO-10303-21 statement/entity structure; B-Rep/units/engineering meaning remain separate",
      "r0": true,
      "r1": "STEP Part 21 header and DATA entity IDs/types/raw statements with line locators",
      "adapter": "step-part21-stdlib-v0.1",
      "status": "supported-structure-only"
    },
    {
      "id": "application/x-freecad",
      "extensions": [
        "fcstd"
      ],
      "ingest": "exact FCStd bytes + ZIP member metadata + Document.xml object/property/dependency structure; shape payload interpretation remains separate",
      "r0": true,
      "r1": "FCStd container and Document.xml structural records",
      "adapter": "freecad-fcstd-stdlib-v0.1",
      "status": "supported-structure-only"
    },
    {
      "id": "model/obj",
      "extensions": [
        "obj"
      ],
      "ingest": "exact reference first",
      "r0": true,
      "r1": null,
      "adapter": null,
      "status": "specialist-adapter-required"
    },
    {
      "id": "model/gltf-binary",
      "extensions": [
        "glb"
      ],
      "ingest": "exact reference first",
      "r0": true,
      "r1": "GLB v2 container/chunk layout plus JSON scene-graph structure and external references",
      "adapter": "gltf-stdlib-v0.1",
      "status": "supported-structure-only"
    },
    {
      "id": "image/svg+xml",
      "extensions": [
        "svg"
      ],
      "ingest": "exact reference + bounded XML/geometry semantics only when admitted",
      "r0": true,
      "r1": "bounded SVG XML element/attribute tree with path locators; no script execution or visual inference",
      "adapter": "svg-xml-stdlib-v0.1",
      "status": "supported"
    },
    {
      "id": "image/png",
      "extensions": [
        "png"
      ],
      "ingest": "exact bytes + metadata; visual semantics require explicit image capability",
      "r0": true,
      "r1": "exact container dimensions/signature metadata only; no visual semantics",
      "adapter": "image-metadata-stdlib-v0.1",
      "status": "supported-metadata-only"
    },
    {
      "id": "image/jpeg",
      "extensions": [
        "jpg",
        "jpeg"
      ],
      "ingest": "exact bytes + metadata; visual semantics require explicit image capability",
      "r0": true,
      "r1": "exact container dimensions/signature metadata only; no visual semantics",
      "adapter": "image-metadata-stdlib-v0.1",
      "status": "supported-metadata-only"
    },
    {
      "id": "model/gltf+json",
      "extensions": [
        "gltf"
      ],
      "ingest": "exact bytes + JSON scene-graph structure; external buffers/images remain separately referenced",
      "r0": true,
      "r1": "glTF JSON graph/container structure and external URI references",
      "adapter": "gltf-stdlib-v0.1",
      "status": "supported-structure-only"
    },
    {
      "id": "image/gif",
      "extensions": [
        "gif"
      ],
      "ingest": "exact bytes + logical-screen dimensions/signature metadata; visual semantics remain separate",
      "r0": true,
      "r1": "GIF container signature and logical-screen dimensions only",
      "adapter": "image-metadata-stdlib-v0.1",
      "status": "supported-metadata-only"
    }
  ],
  "fallback": {
    "status": "R0-reference-only",
    "rule": "Unknown media types may be retained/referenced exactly with hash/provenance but receive no semantic adapter claim until capability is registered."
  }
}
