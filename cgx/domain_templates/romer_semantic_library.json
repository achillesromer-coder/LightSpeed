    "state": {
      "purpose": "Current configuration and controlled historical states.",
      "pattern": "Object -> Configuration -> Revision -> OperatingState",
      "state_objects": [
        "configuration",
        "revision",
        "build",
        "variant",
        "baseline",
        "operating-mode",
        "readiness-state",
        "qualification-state",
        "release-state"
      ]
    },
    "evidence": {
      "purpose": "Append-only evidence and provenance bound to claims/configurations.",
      "pattern": "Claim -> EvidenceSet -> Test/Run/Source -> Receipt",
      "rules": [
        "simulation-does-not-promote-physical",
        "provider-execution-does-not-promote-authority",
        "evidence-bound-to-exact-configuration",
        "uncertainty-and-limitations-first-class"
      ]
    },
    "work": {
      "purpose": "Operational intent and unresolved work; never confused with state-of-the-world facts.",
      "classes": [
        "objective",
        "work-package",
        "task",
        "gate",
        "dependency",
        "unknown",
        "contradiction",
        "risk",
        "decision",
        "approval",
        "queue-item"
