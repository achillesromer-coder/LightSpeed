  "inheritance": {
    "structural": "parent definitions may supply defaults; instances override explicitly",
    "authority": "never inherited implicitly across domain boundaries",
    "security": "strongest-applicable",
    "evidence": "never inherited as proof; children require attributable evidence",
    "configuration": "edges may be configuration-scoped"
  },
  "semantic_expansion_rules": [
    "Prefer new Type_ID or relation subtype over new top-level folder.",
    "Create a child library only when it has reusable vocabulary, independent authority/security, or its own lifecycle.",
    "System families are graph roots, not separate schemas.",
    "A project/programme may reference the same component without duplicating it.",
    "CAD, spreadsheets, code and reports are representations/providers of semantic objects, not the semantic objects themselves."
  ],
  "source_mapping_examples": {
    "Type 1 Romer Cognigrex": "graph + enterprise + programme + publications",
    "Type 1 Systems Cognigrex": "engineering library + system-family state + evidence",
    "Type 1 Operations Cognigrex": "operations + mission/workflow state",
    "Type1 Asteroid Operating Workbook": "missions-logistics specialist graph",
    "MPL Engine": "capability/provider + model/run evidence",
    "M1 Elevated Bypass": "terrestrial infrastructure project graph",
    "LinkDrive/DataIndex": "source/provenance/provider index"
  }
