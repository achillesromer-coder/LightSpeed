{
  "schema_version": "0.4",
  "extensible": true,
  "workflows": [
    {
      "id": "consequence-preflight",
      "steps": [
        "hydrate-task-context",
        "run-assurance-preflight",
        "run-custodial-preflight",
        "merge-holds",
        "emit-consequence-receipt",
        "route-to-authority-gate-or-hold"
      ]
    },
    {
      "id": "assurance-preflight",
      "steps": [
        "classify-system-boundary",
        "classify-lifecycle-phase",
        "classify-environment",
        "classify-domain-and-cascade",
        "route-assurance-methods",
        "resolve-current-sources",
        "run-or-load-method-analyses",
        "verify-controls-and-evidence",
        "emit-assurance-receipt",
        "allow-or-hold"
      ]
    },
    {
      "id": "custodial-extension-preflight",
      "steps": [
        "classify-domain",
        "classify-execution-depth",
        "classify-cascade",
        "resolve-extension-mode",
        "load-parent-extension-source",
        "run-required-checks",
        "emit-extension-receipt",
        "allow-or-hold"
      ]
    },
    {
      "id": "intake-to-canonical",
      "steps": [
        "detect",
        "classify",
        "compare",
        "recommend",
        "review",
        "commit",
        "verify",
        "receipt"
      ]
    },
    {
      "id": "remote-small-edit",
      "steps": [
        "resolve-provider",
        "read-minimum-range",
        "verify-revision",
        "edit",
        "write-bounded-delta",
        "readback",
        "dbr-reconcile"
      ]
    },
    {
      "id": "temporary-offload",
      "steps": [
        "materialise-or-mount",
        "execute-specialist-tool",
        "collect-result-and-receipt",
        "semantic-reconcile",
        "commit-accepted-delta",
        "dispose-or-retain-by-policy"
      ]
    },
    {
      "id": "code-change",
      "steps": [
        "branch-or-sandbox",
        "implement",
        "test",
        "review",
        "commit-receipt",
        "promote-if-authorised"
      ]
    },
    {
      "id": "analysis",
      "steps": [
        "hydrate-current",
        "semi-hydrate-halo",
        "resolve-sources",
        "reason",
        "record-assumptions",
        "propose-delta-or-output"
      ]
    },
    {
      "id": "publish",
      "steps": [
        "select-lens",
        "filter-security",
        "resolve-evidence-ceiling",
        "generate",
        "qa",
        "hash",
        "release-receipt"
      ]
    },
    {
      "id": "build-from-chat",
      "steps": [
        "intent",
        "scope",
        "select-work-mode",
        "materialise",
        "build",
        "verify",
        "present-diff",
        "commit-on-authority"
      ]
    }
  ],
  "extension_preflight": {
    "resolver": "scripts/resolve_cgx_extensions.py",
    "enforcement": "scripts/cgx_custodial_preflight.py",
    "source": "Cognigrex.cgx:/extensions/cgp-ies",
    "rule": "resolve before consequential execution or promotion; review and read paths remain observational unless the task context requires a higher mode",
    "receipt_required": true,
    "upstream_required_for_consequence": "CGX-ASSURANCE-PREFLIGHT receipt when assurance route is VERIFY/SAFETY_CASE/HOLD"
  },
  "assurance_preflight": {
    "router": "scripts/cgx_assurance_route.py",
    "enforcement": "scripts/cgx_assurance_preflight.py",
    "source": "Cognigrex.cgx:/assurance",
    "ordering": "assurance before custodial GATE and before consequential execution",
    "receipt_required": true,
    "rule": "clearance means bounded assurance evidence only; risk acceptance, custodial approval, legal approval and execution authority remain separate"
  },
  "consequence_preflight": {
    "executable": "scripts/cgx_consequence_preflight.py",
    "tests": "scripts/validate_cgx_preflight_chain.py",
    "ordering": [
      "evidence-qualification",
      "assurance",
      "custodial",
      "authority/risk-acceptance",
      "execution-lease",
      "independent-safety",
      "tool-execution",
      "telemetry/readback"
    ],
    "terminal_clear_state": "CLEARED_FOR_AUTHORITY_GATE",
    "rule": "preflight clearance is not permission to execute"
  }
}
