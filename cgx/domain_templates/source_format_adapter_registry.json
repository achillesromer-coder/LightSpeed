{
  "schema": "CGX-SOURCE-FORMAT-ADAPTER-REGISTRY/0.1",
  "status": "implementation-subset",
  "default_mode": "native-preserving-read-only-projection",
  "adapters": [
    {
      "adapter_id": "text-stdlib-v0.1",
      "extensions": [
        ".txt",
        ".md",
        ".markdown",
        ".py",
        ".yaml",
        ".yml",
        ".ini",
        ".cfg",
        ".toml"
      ],
      "media_families": [
        "text"
      ],
      "projection_kinds": [
        "text",
        "structure",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "SEMANTIC_PROJECTION_ONLY",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE"
    },
    {
      "adapter_id": "json-stdlib-v0.1",
      "extensions": [
        ".json",
        ".jsonl"
      ],
      "media_families": [
        "structured-text"
      ],
      "projection_kinds": [
        "structure",
        "text",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "LOSSLESS_FOR_DECLARED_FIELDS",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE"
    },
    {
      "adapter_id": "csv-stdlib-v0.1",
      "extensions": [
        ".csv",
        ".tsv"
      ],
      "media_families": [
        "table"
      ],
      "projection_kinds": [
        "table",
        "structure",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "LOSSLESS_FOR_DECLARED_FIELDS",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE"
    },
    {
      "adapter_id": "html-stdlib-v0.1",
      "extensions": [
        ".html",
        ".htm"
      ],
      "media_families": [
        "document"
      ],
      "projection_kinds": [
        "text",
        "structure",
        "relationship"
      ],
      "deep_parse": true,
      "round_trip_claim": "SEMANTIC_PROJECTION_ONLY",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "HTML parsing is non-executing; script/style bodies are excluded from visible-text projection."
    },
    {
      "adapter_id": "docx-ooxml-stdlib-v0.1",
      "extensions": [
        ".docx"
      ],
      "media_families": [
        "document"
      ],
      "projection_kinds": [
        "text",
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "SEMANTIC_PROJECTION_ONLY",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE"
    },
    {
      "adapter_id": "xlsx-ooxml-stdlib-v0.1",
      "extensions": [
        ".xlsx",
        ".xlsm"
      ],
      "media_families": [
        "workbook"
      ],
      "projection_kinds": [
        "table",
        "formula",
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE"
    },
    {
      "adapter_id": "pdf-pypdf-v0.1",
      "extensions": [
        ".pdf"
      ],
      "media_families": [
        "document"
      ],
      "projection_kinds": [
        "metadata"
      ],
      "deep_parse": false,
      "round_trip_claim": "IDENTITY_REFERENCE_ONLY",
      "note": "Generic source_intake preserves PDF identity; registered specialist PDF capability must be bound for R1.",
      "admission_state": "CAPABILITY_BINDING_REQUIRED"
    },
    {
      "adapter_id": "image-reference-v0.1",
      "extensions": [
        ".webp",
        ".tif",
        ".tiff"
      ],
      "media_families": [
        "image"
      ],
      "projection_kinds": [
        "metadata",
        "preview"
      ],
      "deep_parse": false,
      "round_trip_claim": "IDENTITY_REFERENCE_ONLY",
      "note": "Semantic vision output is a derived representation and must retain source-image identity.",
      "admission_state": "REFERENCE_ONLY",
      "conversion_class": "R0_EXACT"
    },
    {
      "adapter_id": "gltf-stdlib-v0.1",
      "extensions": [
        ".gltf",
        ".glb"
      ],
      "media_families": [
        "spatial"
      ],
      "projection_kinds": [
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "glTF/GLB JSON graph and container/chunk structure only; external resources remain referenced."
    },
    {
      "adapter_id": "svg-xml-stdlib-v0.1",
      "extensions": [
        ".svg"
      ],
      "media_families": [
        "image-vector"
      ],
      "projection_kinds": [
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Bounded XML element/attribute tree with path locators; scripts are never executed and visual meaning is not inferred."
    },
    {
      "adapter_id": "image-metadata-stdlib-v0.1",
      "extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".gif"
      ],
      "media_families": [
        "image"
      ],
      "projection_kinds": [
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "LOSSLESS_FOR_DECLARED_FIELDS",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Container signature and pixel dimensions only; no OCR, vision interpretation, EXIF inference or visual semantics."
    },
    {
      "adapter_id": "step-part21-stdlib-v0.1",
      "extensions": [
        ".step",
        ".stp"
      ],
      "media_families": [
        "spatial-cad"
      ],
      "projection_kinds": [
        "structure",
        "metadata",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "ISO-10303-21 statement/entity structure only; no B-Rep validation, unit inference, topology solution or engineering interpretation."
    },
    {
      "adapter_id": "freecad-fcstd-stdlib-v0.1",
      "extensions": [
        ".fcstd"
      ],
      "media_families": [
        "spatial-cad"
      ],
      "projection_kinds": [
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "FCStd ZIP member metadata and Document.xml structure only; embedded shape payloads remain native/uninterpreted."
    },
    {
      "adapter_id": "obj-mesh-stdlib-v0.1",
      "extensions": [
        ".obj"
      ],
      "media_families": [
        "spatial-mesh"
      ],
      "projection_kinds": [
        "structure",
        "relationship",
        "metadata",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Exact bounded OBJ mesh records and line locators; materials/referenced files are names only and engineering interpretation is not performed."
    },
    {
      "adapter_id": "stl-mesh-stdlib-v0.1",
      "extensions": [
        ".stl"
      ],
      "media_families": [
        "spatial-mesh"
      ],
      "projection_kinds": [
        "structure",
        "metadata",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Exact bounded binary/ASCII STL triangle structure with byte/line locators; no topology, units or engineering interpretation."
    },
    {
      "adapter_id": "pptx-ooxml-stdlib-v0.1",
      "extensions": [
        ".pptx"
      ],
      "media_families": [
        "presentation"
      ],
      "projection_kinds": [
        "text",
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "OOXML slide parts, text runs, relationship-part references and shape-like element counts; macros are not executed and visual layout is not inferred."
    },
    {
      "adapter_id": "xml-stdlib-v0.1",
      "extensions": [
        ".xml"
      ],
      "media_families": [
        "structured-text"
      ],
      "projection_kinds": [
        "structure",
        "text",
        "metadata",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Bounded XML element/attribute/text tree with stable element paths; external entities/scripts are not executed."
    },
    {
      "adapter_id": "zip-stdlib-v0.1",
      "extensions": [
        ".zip"
      ],
      "media_families": [
        "archive"
      ],
      "projection_kinds": [
        "structure",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "Archive directory structure and member metadata only; member payload semantics remain separately gated."
    },
    {
      "adapter_id": "ply-mesh-stdlib-v0.1",
      "extensions": [
        ".ply"
      ],
      "media_families": [
        "spatial-mesh"
      ],
      "projection_kinds": [
        "structure",
        "metadata",
        "citation_map"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "PLY header encoding/version/element/property structure and body offset only; body geometry is not decoded and units are not inferred."
    },
    {
      "adapter_id": "3mf-stdlib-v0.1",
      "extensions": [
        ".3mf"
      ],
      "media_families": [
        "spatial-additive"
      ],
      "projection_kinds": [
        "structure",
        "relationship",
        "metadata"
      ],
      "deep_parse": true,
      "round_trip_claim": "STRUCTURE_PRESERVED",
      "admission_state": "IMPLEMENTED",
      "conversion_class": "R1_SEMANTIC_REVERSIBLE",
      "note": "3MF package/model object and mesh counts with exact declared unit attribute where present; mesh validity and engineering intent are not inferred."
    }
  ],
  "fallback": {
    "adapter_id": "binary-reference-v1",
    "projection_kinds": [
      "metadata"
    ],
    "round_trip_claim": "IDENTITY_REFERENCE_ONLY",
    "rule": "Unknown formats remain content-addressed references with no guessed semantic extraction."
  },
  "parent_type_registry": "file_type_conversion_registry.json",
  "rule": "This registry describes concrete generic source-intake implementations only. file_type_conversion_registry.json decides admitted R1 capability/status."
}
