{
  "schema": "CGX-ASSURANCE-SELECTION-MATRIX/0.1",
  "rule": "Selection is additive and contextual. A matched method adds a lens; it does not suppress other applicable lenses. SAFETY_CASE state also requires the assurance-case contract even when the triggering specialist route is different.",
  "routes": [
    {
      "id": "AR-01",
      "match": {
        "tags_any": [
          "hardware",
          "component",
          "interface",
          "manufacturing",
          "maintenance",
          "failure"
        ]
      },
      "methods": [
        "FMEA",
        "V_AND_V"
      ],
      "minimum_state": "ANALYSE"
    },
    {
      "id": "AR-02",
      "match": {
        "tags_any": [
          "criticality",
          "single-point-failure",
          "mission-loss",
          "catastrophic-failure"
        ]
      },
      "methods": [
        "FMECA",
        "FTA",
        "V_AND_V"
      ],
      "minimum_state": "VERIFY"
    },
    {
      "id": "AR-03",
      "match": {
        "tags_any": [
          "process",
          "chemical",
          "pressure",
          "thermal",
          "flow",
          "operability"
        ]
      },
      "methods": [
        "HAZOP",
        "HAZARD_ANALYSIS",
        "BOW_TIE"
      ],
      "minimum_state": "ANALYSE"
    },
    {
      "id": "AR-04",
      "match": {
        "tags_any": [
          "autonomy",
          "robot",
          "ai-control",
          "software-control",
          "swarm",
          "agent",
          "llm"
        ]
      },
      "methods": [
        "STPA",
        "AI_IMPACT",
        "CYBER_THREAT",
        "FUNCTIONAL_SAFETY",
        "AGENTIC_SECURITY",
        "SOFTWARE_SAFETY"
      ],
      "minimum_state": "ANALYSE"
    },
    {
      "id": "AR-05",
      "match": {
        "tags_any": [
          "replication-control",
          "hard-stop",
          "life-support",
          "containment",
          "hazard-control"
        ]
      },
      "methods": [
        "FUNCTIONAL_SAFETY",
        "FTA",
        "CONTINUITY_RECOVERY",
        "V_AND_V",
        "SOFTWARE_SAFETY"
      ],
      "minimum_state": "SAFETY_CASE"
    },
    {
      "id": "AR-06",
      "match": {
        "tags_any": [
          "australian-launch",
          "return-authorisation",
