      ],
      "minimum_state": "SAFETY_CASE"
    },
    {
      "id": "AR-09",
      "match": {
        "domain": [
          "eco"
        ],
        "tags_any": [
          "field-deployment",
          "species-movement",
          "inoculation",
          "seed",
          "spore",
          "soil",
          "water",
          "habitat",
          "ecosystem-intervention",
          "life-impact"
        ]
      },
      "methods": [
        "ECO_BIOSECURITY",
        "HAZARD_ANALYSIS",
