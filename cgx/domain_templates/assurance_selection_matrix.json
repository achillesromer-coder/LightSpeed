      },
      "methods": [
        "HAZOP",
        "LOPA",
        "FUNCTIONAL_SAFETY",
        "V_AND_V"
      ],
      "minimum_state": "VERIFY"
    },
    {
      "id": "AR-17",
      "match": {
        "tags_any": [
          "human-factors",
          "operator",
          "maintenance-access",
          "fatigue",
          "warning-design",
          "emergency-egress",
