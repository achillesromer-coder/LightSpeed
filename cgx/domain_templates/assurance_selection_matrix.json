        "V_AND_V"
      ],
      "minimum_state": "ANALYSE"
    }
  ],
  "escalation": [
    {
      "when": {
        "cascade_min": "C3"
      },
      "minimum_state": "VERIFY"
    },
    {
      "when": {
        "execution_depth": [
          "execute",
          "build"
        ],
        "cascade_min": "C2"
      },
      "minimum_state": "VERIFY"
    },
    {
      "when": {
        "tags_any": [
          "replication-control",
          "planetary-protection",
          "unknown-life",
          "life-support",
          "nuclear",
          "radioactive",
          "catastrophic-failure"
        ]
      },
      "minimum_state": "SAFETY_CASE"
    }
  ]
}
