      },
      "methods": [
        "HAZARD_ANALYSIS",
        "FTA",
        "ETA",
        "SPACE_DEBRIS",
        "QRA_PRA",
        "V_AND_V"
      ],
      "minimum_state": "VERIFY"
    },
    {
      "id": "AR-08",
      "match": {
        "tags_any": [
          "planetary-protection",
          "sample-return",
          "unknown-life",
          "extraterrestrial-biology"
