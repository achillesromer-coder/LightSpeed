        "CYBER_THREAT",
        "V_AND_V"
      ],
      "minimum_state": "VERIFY"
    },
    {
      "id": "AR-07",
      "match": {
        "tags_any": [
          "asteroid",
          "offworld-extraction",
          "fragmentation",
          "ejecta",
          "conjunction",
          "orbital-object"
