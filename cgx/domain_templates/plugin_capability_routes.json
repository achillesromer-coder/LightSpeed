{
  "schema": "CGX-CAPABILITY-ROUTES/0.3",
  "toolkit_registry": "cgx/domain_templates/toolkit_registry.json",
  "rule": "Route to existing typed functions/providers/workflows; capability does not create authority.",
  "routes": {
    "interface.help": {
      "state": "workflow",
      "kind": "skill",
      "ro": true,
      "skill": "cgx-capability-router"
    },
    "interface.capabilities": {
      "state": "workflow",
      "kind": "skill",
      "ro": true,
      "skill": "cgx-capability-router"
    },
    "cgx.resolve_context": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_plugin_control:build_context_envelope"
    },
    "cgx.minimum_work": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_plugin_control:decide_minimum_sufficient_work"
    },
    "cgx.plan_query": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_query_planner:compile_query_plan"
    },
    "cgx.cross_analysis": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_cross_analysis:build_cross_analysis_plan",
      "uses": [
        "cgx.resolve_context",
        "cgx.object_context",
        "cgx.plan_query",
        "cgx.minimum_work",
        "consequence.preflight",
        "science.query",
        "tests.plan",
        "local.supervise"
      ],
      "limitation": "Plans bounded cross-analysis; it does not automatically execute tests/sweeps or promote results."
    },
    "local.supervise": {
      "state": "available",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.cognigrex_supervisor:run_supervised_workflow",
      "gate": "bounded local receipts; heavy=false unless explicit"
    },
    "tests.plan": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.corpus_test_orchestrator:plan_cascade"
    },
    "science.query": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.scientific_query:execute_scientific_query"
    },
    "science.rfs_emff_sweep": {
      "state": "available",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.rfs_emff_sweep:execute_sweep",
      "gate": "bounded immutable sweep"
    },
    "science.mark3_simulate": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.mark3_multi_unit:simulate_scenario"
    },
    "receipts.list": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.result_receipt_browser:list_result_receipts"
    },
    "receipts.open": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.result_receipt_browser:open_result_receipt"
    },
    "files.list": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.project_file_browser:list_project_files"
    },
    "files.open": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.project_file_browser:open_project_file"
    },
    "sources.envelope": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.source_intake:build_source_envelope_from_path"
    },
    "data.validate": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.analytics_validation:build_table_validation_report"
    },
    "knowns.read": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.knowns:read_knowns_registry"
    },
    "knowns.proof_queue": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.knowns:build_knowns_proofing_queue"
    },
    "knowns.promote": {
      "state": "gated",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.knowns:promote_knowns_entries",
      "gate": "Achilles/owner promotion authority"
    },
    "governance.action_ledger": {
      "state": "gated",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.governance_ledgers:append_action_ledger",
      "gate": "bounded operational write"
    },
    "governance.approval_ledger": {
      "state": "gated",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.governance_ledgers:append_approval_ledger",
      "gate": "approval context required"
    },
    "ops.health": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.bridge_health:build_bridge_health"
    },
    "ops.route_probe": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "open_world": true,
      "handler": "lightspeed_runtime.route_probe:build_route_probe_report"
    },
    "ops.queue": {
      "state": "gated",
      "kind": "runtime",
      "ro": false,
      "handler": "lightspeed_runtime.smith_router:queue_smith_job",
      "gate": "bounded queue write"
    },
    "ops.finalize": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.finalization_control:build_finalization_overview"
    },
    "ops.consolidate": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.consolidation_registry:build_consolidation_register"
    },
    "definitions.search": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.definition_library:search_it_dictionary"
    },
    "entities.build": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.entity_registry:build_entity_registry"
    },
    "protocols.build": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.protocol_sequence_registry:build_protocol_sequence_registry"
    },
    "eco.assess": {
      "state": "assisted",
      "kind": "composite",
      "ro": true,
      "uses": [
        "cgx.resolve_context",
        "sources.envelope",
        "science.query",
        "cgx.cross_analysis"
      ],
      "limitation": "No dedicated deterministic ecology engine is present."
    },
    "cad.freecad": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.freecad_adapter:inspect_freecad_document",
      "uses": [
        "cad.freecad.probe"
      ],
      "limitation": "Read-only FCStd inspection within registered project roots; no save/export/write operation is exposed."
    },
    "physics.femm": {
      "state": "missing",
      "kind": "planned-tool",
      "ro": false,
      "limitation": "No FEMM toolkit entry or typed adapter was found."
    },
    "extensions.tool": {
      "state": "workflow",
      "kind": "skill",
      "ro": false,
      "skill": "cgx-tool-extension",
      "gate": "implement/test/register before tool exposure",
      "uses": [
        "extensions.plan"
      ]
    },
    "node.exchange.status": {
      "state": "assisted",
      "kind": "composite",
      "ro": true,
      "uses": [
        "ops.health",
        "ops.route_probe",
        "receipts.list"
      ],
      "limitation": "The cgx/node-exchange-2026-10-02 lane owns the transport/compute adapter. This capability-facade branch exposes status and handoff only until that adapter is promoted."
    },
    "node.transfer": {
      "state": "gated",
      "kind": "composite",
      "ro": false,
      "uses": [
        "cgx.resolve_context",
        "cgx.minimum_work",
        "node.exchange.status"
      ],
      "gate": "Requires promoted node-exchange adapter, registered target root, DIGITAL_WRITE-or-stronger scoped lease, content hash verification, and exact receiver readback.",
      "authority_transfer": false
    },
    "node.compute": {
      "state": "gated",
      "kind": "composite",
      "ro": false,
      "uses": [
        "cgx.resolve_context",
        "cgx.minimum_work",
        "node.exchange.status"
      ],
      "gate": "Requires promoted node-exchange adapter, independently proven target compute capability, COMPUTE_ONLY-or-stronger scoped lease, verified input receipts, and heavy=false unless separately authorized.",
      "authority_transfer": false
    },
    "assurance.preflight": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_preflight:build_assurance_preflight",
      "limitation": "Assurance clearance bounds method evidence only; it does not grant execution authority."
    },
    "custodial.preflight": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_preflight:build_custodial_preflight",
      "limitation": "Custodial checks may HOLD work but do not create semantic or execution authority."
    },
    "consequence.preflight": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_preflight:build_consequence_preflight",
      "uses": [
        "assurance.preflight",
        "custodial.preflight"
      ],
      "limitation": "CLEARED_FOR_AUTHORITY_GATE is not execution permission."
    },
    "extensions.plan": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_extension_planner:plan_tool_extension",
      "limitation": "Plans reuse/wrap/build decisions only; it does not install or expose tools."
    },
    "cad.freecad.probe": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.freecad_adapter:probe_freecad"
    },
    "cad.freecad.bom": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.freecad_adapter:extract_freecad_bom",
      "uses": [
        "cad.freecad.probe"
      ],
      "limitation": "Derived geometry/object summary only; not an approved manufacturing or procurement BOM."
    },
    "cgx.object_context": {
      "state": "available",
      "kind": "runtime",
      "ro": true,
      "handler": "lightspeed_runtime.cgx_object_context:resolve_object_context",
      "limitation": "Read-only resolution of current object/twin lineage into child-domain identity, Operations binding, source owner and representation boundary; no object creation or authority promotion."
    }
  },
  "gaps": [
    {
      "id": "femm-adapter",
      "state": "missing",
      "priority": "high",
      "note": "Add only after verified local installation/model contract."
    },
    {
      "id": "eco-deterministic-engine",
      "state": "missing",
      "priority": "high",
      "note": "Current ecology route is source/query/cross-analysis assisted."
    },
    {
      "id": "node-exchange-runtime-promotion",
      "state": "partial",
      "priority": "high",
      "note": "Transport/compute mechanics are active in separate cgx/node-exchange-2026-10-02 lane; capability facade remains gated until that runtime contract is promoted/merged."
    }
  ],
  "extension": {
    "reuse_before_create": true,
    "single_shared_tool_plane": true,
    "sequence": [
      "define goal",
      "run extensions.plan",
      "search registry/runtime/toolkits",
      "reuse or alias when sufficient",
      "implement smallest typed adapter only when missing",
      "add tests/receipt",
      "register route/shortcall once",
      "rebuild packages",
      "expose validated operations individually through one shared MCP plane after transport validation"
    ]
  },
  "shared_tool_plane": {
    "state": "available_local",
    "server": "lightspeed-cgx",
    "transport": "stdio",
    "scope": "one shared tool plane for all nine selectors",
    "tools": [
      "cgx_get_capabilities",
      "cgx_resolve_shortcall",
      "cgx_resolve_object",
      "cgx_plan_cross_analysis",
      "cgx_consequence_preflight",
      "cgx_plan_tool_extension",
      "cgx_bridge_health",
      "cgx_list_receipts",
      "cgx_open_receipt",
      "cgx_plan_local_work",
      "cgx_run_local_work",
      "cgx_freecad_probe",
      "cgx_freecad_inspect",
      "cgx_freecad_bom"
    ],
    "execution_boundary": {
      "generic_shell": false,
      "arbitrary_python": false,
      "arbitrary_path_open": false,
      "heavy_execution": false,
      "local_run_requires_confirmed_true": true,
      "canonical_promotion": false,
      "public_publish": false
    },
    "proof": {
      "selftest": "D:\\LightSpeed\\State\\Review\\CGX_SHARED_MCP_20261003\\mcp_selftest_freecad2.txt",
      "execution_proof": "D:\\LightSpeed\\State\\Review\\CGX_SHARED_MCP_20261003\\mcp_execute_proof.txt",
      "freecad_mcp_proof": "D:\\LightSpeed\\State\\Review\\FreeCAD_ADAPTER_20261003\\mcp_freecad_proof.json"
    },
    "freecad_boundary": {
      "state": "available_read_only",
      "observed_version": "FreeCAD 1.0.2 Revision: 39319 (Git)",
      "allowed_formats": [
        ".FCStd"
      ],
      "writes_exports": "not_exposed"
    }
  }
}
