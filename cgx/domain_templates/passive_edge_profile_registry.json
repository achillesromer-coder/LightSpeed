      "eligible_views": [
        "text",
        "svg-lite",
        "event-delta"
      ]
    },
    {
      "id": "T2_STANDARD",
      "max_transfer_bytes": 1048576,
      "chunk_bytes": 32768,
      "max_in_flight": 2,
      "preferred": "verified source ranges and type projections",
      "eligible_views": [
        "text",
        "svg",
        "table",
        "basic-3d"
      ]
    },
    {
      "id": "T3_EXTENDED",
      "max_transfer_bytes": 8388608,
      "chunk_bytes": 131072,
      "max_in_flight": 4,
      "preferred": "verified larger packages and richer views subject to platform limits",
      "eligible_views": [
        "text",
        "svg",
        "3d",
        "media",
        "offline-pack"
      ]
    }
  ],
