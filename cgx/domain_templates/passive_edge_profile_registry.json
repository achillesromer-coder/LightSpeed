  "source_states": [
    "UNKNOWN",
    "NOT_CACHED",
    "WITHHELD",
    "UNSUPPORTED_VIEW",
    "NOT_AUTHORISED",
    "CONTESTED",
    "OBSERVED_ZERO"
  ],
  "packet_rule": {
    "private_keys": "never in packet",
    "auth_tokens": "never in packet",
    "source_paths": "never self-authorizing",
    "watch_sensor_data": "never in a public/bootstrap packet",
    "node_id": "null until independently enrolled",
    "state_root": "verify from trusted resolver",
    "public_asset_gate": "#158",
    "peer_acceptance_gate": "#161",
    "canonical_mutation": false,
    "server_binding": "mandatory for any shared mutable state"
  },
  "security_invariants": [
    "least privilege",
    "HTTPS selected explicitly; no loopback or local IP from hosted page",
    "source SHA-256 plus exact byte readback",
    "CAS prior state root and replay/nonce checks at authenticated receiver",
    "no auto-discovery of private apps",
    "no unauthorized sensor data",
    "no arbitrary shell/actuation",
    "no fabricated offline peer acknowledgement",
    "no inference of full fidelity from semantic alias"
  ],
  "acceptance_cases": [
    "T0 offline import/export exact source hash",
    "T1 bad prior-root rejects delta",
    "T2 missing dependency returns NOT_CACHED",
    "unverified watch stays source-only",
    "public packet never contains secret/health data",
    "private or loopback host rejected",
    "same bytes can deduplicate without merging independent Object_IDs",
    "valid device still cannot claim canonical authority",
    "explicit signed peer receipt required before VERIFIED",
    "source-only branch must retain PR #158/#161 gates"
  ]
}
