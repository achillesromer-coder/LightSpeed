{
  "schema_version": "0.1",
  "secrets_policy": "references-only-no-secret-bytes",
  "extensible": true,
  "toolkits": [
    {
      "id": "cgx-core",
      "kind": "base",
      "binding": "master-hydration",
      "capabilities": [
        "filespace",
        "db-r",
        "security",
        "routing",
        "host",
        "ccc",
        "extension-resolution",
        "custodial-preflight",
        "assurance-routing",
        "assurance-preflight",
        "unified-risk-object"
      ]
    },
    {
      "id": "lightspeed",
      "kind": "runtime",
      "binding": "local-or-distributed",
      "capabilities": [
        "compute-routing",
        "jobs",
        "receipts",
        "local-llm",
        "remote-llm",
        "tools"
      ]
    },
    {
      "id": "openai",
      "kind": "api",
      "binding": "optional",
      "api_style": "responses",
      "credential_ref": "env:OPENAI_API_KEY",
      "capabilities": [
        "reasoning",
        "vision",
        "tool-use",
        "structured-output"
      ],
      "secret_in_carrier": false
    },
    {
      "id": "local-llm",
      "kind": "runtime",
      "binding": "optional",
      "credential_ref": null,
      "capabilities": [
        "private-reasoning",
        "offline-reasoning"
      ]
    },
    {
      "id": "google-drive",
      "kind": "provider",
      "binding": "oauth-or-provider-managed",
      "capabilities": [
        "read",
        "range-read",
        "bounded-write",
        "native-docs",
        "native-sheets",
        "native-slides",
        "file-lifecycle"
      ]
    },
    {
      "id": "github",
      "kind": "provider",
      "binding": "oauth-or-token-ref",
      "credential_ref": "provider-managed-or-env:GITHUB_TOKEN",
      "capabilities": [
        "code",
        "branches",
        "tests",
        "issues",
        "pull-requests",
        "commits"
      ]
    },
    {
      "id": "python",
      "kind": "local-tool",
      "binding": "host",
      "capabilities": [
        "analysis",
        "simulation",
        "conversion",
        "automation"
      ]
    },
    {
      "id": "freecad",
      "kind": "desktop-tool",
      "binding": "host",
      "capabilities": [
        "cad",
        "fcstd",
        "geometry",
        "object-tree",
        "derived-bom",
        "read-only-inspection"
      ],
      "state": "available_read_only",
      "executable_ref": "host:user-home/Desktop/Programs/FreeCAD 1.0/bin/freecadcmd.exe",
      "observed_version": "FreeCAD 1.0.2 Revision: 39319 (Git)",
      "write_operations": "not_exposed",
      "override_ref": "env:FREECAD_BIN"
    },
    {
      "id": "web",
      "kind": "provider",
      "binding": "network",
      "capabilities": [
        "research",
        "public-evidence",
        "urls"
      ]
    },
    {
      "id": "email",
      "kind": "provider",
      "binding": "oauth",
      "capabilities": [
        "draft",
        "attachment-package",
        "send-gated"
      ]
    },
    {
      "id": "calendar",
      "kind": "provider",
      "binding": "oauth",
      "capabilities": [
        "read",
        "schedule-gated"
      ]
    },
    {
      "id": "ccc",
      "kind": "package-registry",
      "binding": "cgx-native",
      "capabilities": [
        "discover",
        "plan",
        "verify",
        "apply",
        "unapply",
        "receipts"
      ]
    }
  ],
  "extension_contract": {
    "add_provider": true,
    "add_tool": true,
    "add_api": true,
    "add_skill": true,
    "scope_to_region_or_object": true,
    "add_policy_extension": true,
    "policy_extension_rule": "shared parent source + scoped child binding + receipt; capability does not create authority",
    "add_assurance_method": true,
    "assurance_method_rule": "new methods declare question, inputs, outputs, assumptions, applicability, evidence and limitations; they do not create authority or a universal risk score"
  },
  "interoperability_surfaces": {
    "filespace": {
      "routes": [
        "files.list",
        "files.open",
        "sources.envelope",
        "cgx.object_context"
      ],
      "toolkits": [
        "cgx-core",
        "google-drive",
        "github"
      ],
      "provider_candidates": [
        "Google_Drive",
        "GitHub",
        "Microsoft_SharePoint"
      ],
      "boundary": "Existing scoped file/reference routes; native occurrence ACL/provider binding still required."
    },
    "dataspace": {
      "routes": [
        "data.validate",
        "receipts.list",
        "receipts.open",
        "knowns.read",
        "ops.queue"
      ],
      "toolkits": [
        "cgx-core",
        "lightspeed",
        "python"
      ],
      "provider_candidates": [
        "Neon",
        "Supabase",
        "Google_Drive"
      ],
      "boundary": "Existing validation and receipt routes; database operation adapters require independent qualification."
    },
    "unispace": {
      "routes": [
        "cgx.resolve_context",
        "cgx.object_context",
        "node.exchange.status",
        "runtime.productization"
      ],
      "toolkits": [
        "cgx-core",
        "lightspeed",
        "ccc"
      ],
      "provider_candidates": [
        "Browser",
        "Vercel"
      ],
      "boundary": "Permissioned projections; no deployment or publication implied."
    },
    "remote-desktop": {
      "routes": [
        "ops.health",
        "node.exchange.status",
        "node.transfer",
        "node.compute",
        "local.supervise"
      ],
      "toolkits": [
        "lightspeed",
        "cgx-core",
        "python"
      ],
      "provider_candidates": [
        "Remote_Desktop_Commander",
        "Browser"
      ],
      "boundary": "Local routes are not RDC or remote peer proof; require exact typed connector adapter, host scope, lease, and readback."
    },
    "agent": {
      "routes": [
        "cgx.resolve_context",
        "cgx.plan_query",
        "cgx.cross_analysis",
        "local.supervise",
        "extensions.plan",
        "tests.plan"
      ],
      "toolkits": [
        "cgx-core",
        "lightspeed",
        "local-llm",
        "openai",
        "ccc"
      ],
      "provider_candidates": [
        "OpenAI_Platform",
        "Automations",
        "Plugin_Creator",
        "Plugin_Management"
      ],
      "boundary": "Source/skill routing only; connection, scheduling, execution, training and authority remain separately gated."
    },
    "engineering": {
      "routes": [
        "science.query",
        "science.fractal_grid",
        "cad.freecad",
        "physics.femm",
        "science.gmat.probe",
        "extensions.plan"
      ],
      "toolkits": [
        "python",
        "freecad",
        "lightspeed",
        "github"
      ],
      "provider_candidates": [
        "GitHub",
        "Vercel",
        "Neon",
        "Supabase"
      ],
      "boundary": "Preserve solver and provider gaps; no arbitrary shell or physical actuation."
    },
    "communication": {
      "routes": [
        "cgx.minimum_work",
        "consequence.preflight",
        "extensions.plan"
      ],
      "toolkits": [
        "email",
        "calendar",
        "web"
      ],
      "provider_candidates": [
        "Gmail",
        "Google_Calendar",
        "Google_Contacts",
        "Microsoft_Outlook_Email",
        "Microsoft_Outlook_Calendar",
        "Slack",
        "Circleback",
        "LinkedIn"
      ],
      "boundary": "Provider-specific scope and explicit consequential action gates; no sending or scheduling from metadata."
    },
    "creative": {
      "routes": [
        "extensions.plan",
        "portfolio.printable_catalogue"
      ],
      "toolkits": [
        "web",
        "google-drive",
        "ccc"
      ],
      "provider_candidates": [
        "Canva",
        "invideo"
      ],
      "boundary": "Provider adapters and source rights require qualification; no automatic publication."
    },
    "research": {
      "routes": [
        "definitions.search",
        "knowns.read",
        "science.query",
        "cgx.cross_analysis"
      ],
      "toolkits": [
        "web",
        "python",
        "google-drive"
      ],
      "provider_candidates": [
        "Google_Drive",
        "GitHub"
      ],
      "boundary": "Original source, revision, rights and proof required."
    }
  }
}
