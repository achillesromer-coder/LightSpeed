  "inheritance": {
    "taxonomy": "taxonomic traits may inherit only where scientifically valid and explicitly modelled",
    "spatial": "place hierarchy may provide environmental context but not overwrite site observations",
    "authority": "jurisdiction/owner scoped; never inferred from geography alone",
    "security": "strongest-applicable",
    "evidence": "no ecological claim inherits proof solely from a related species/site",
    "temporal": "latest state does not supersede historical observations"
  },
  "semantic_expansion_rules": [
    "Prefer adding taxa, interaction or process types to controlled registries rather than creating new top-level structures.",
    "Every field observation is immutable and time/place bound.",
    "Species/taxon identity is separate from local population and local observation.",
    "Intervention object is separate from ecological response object.",
    "A site may hold multiple simultaneous state estimates from different methods; reconciliation creates a reviewed estimate without deleting originals.",
    "New restoration families become child libraries only when they have reusable composition/process/test vocabulary."
  ],
  "source_mapping_examples": {
    "Type 1 Eco-Grex": "domain graph + governance + evidence",
    "Embedded Bio Blocks": "intervention family + experiment + monitoring",
    "Second Cycle": "intervention family + water/ecology process + monitoring",
    "M1/SEQLD ecological interfaces": "cross-domain references to Romer.cgx, not duplicated engineering state",
    "field datasets": "observation/evidence objects",
    "public ecology materials": "derived views only"
  }
