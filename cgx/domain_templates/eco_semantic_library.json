    "graph": {
      "purpose": "Persistent living graph of places, organisms, processes, interventions and relationships.",
      "roots": [
        "places-landscapes",
        "taxa-populations-communities",
        "ecological-processes",
        "pressures-threats",
        "interventions-restoration",
        "monitoring-observations",
