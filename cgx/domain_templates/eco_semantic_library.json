        "education-participation",
        "publications"
      ],
      "canonical_intervention_families": [
        "embedded-bio-blocks",
        "second-cycle"
      ]
    },
    "state": {
      "purpose": "Time-indexed ecological condition rather than configuration replacement.",
      "pattern": "Entity/Place -> Observation/Event -> StateEstimate -> Trend -> Intervention -> Response",
      "state_objects": [
        "baseline",
        "state-estimate",
        "condition",
        "trend",
        "target-state",
        "reference-condition",
        "counterfactual",
        "seasonal-state",
        "disturbance-event",
        "recovery-state"
      ]
    },
    "evidence": {
      "purpose": "Append-only observations, samples and analyses; raw observations remain immutable.",
      "pattern": "Observation/Sample -> Analysis -> StateEstimate/Claim -> Review",
      "rules": [
        "observation-is-not-overwritten-by-later-state",
        "absence-of-observation-is-not-proof-of-absence",
        "site-and-time-context-required",
        "taxonomic-confidence-first-class",
        "measurement-method-and-detection-limit-first-class",
        "intervention-effect-needs-comparator-or-explicit-observational-limit"
      ]
    },
    "work": {
      "purpose": "Adaptive management and unresolved ecological questions.",
      "classes": [
        "objective",
        "management-action",
        "monitoring-plan",
        "sampling-plan",
        "unknown",
