    "ignored_files": [
      "Thumbs.db",
      ".DS_Store"
    ],
    "max_hash_bytes": 1073741824,
    "registry_refresh_seconds": 60,
    "project_change_debounce_seconds": 120
  },
  "drive_writeback": {
    "mode": "owner_approved_exact_target_or_local_outbox",
    "approval_source": "config/launch_control.json#manual_gates[gate_id=drive_writeback]",
    "required_gate_state": "owner_approved_exact_target",
    "required_owner": "Nathaniel Bouwer",
    "approved_target_field": "approved_target",
    "decision_id_field": "decision_id",
    "require_existing_target_directory": true,
    "local_fallback_path": "Z Axis/Z-4_Merovingian/data/runtime_exports/drive_outbox",
    "write_scope": "immutable named project artifacts, receipts, manifests, provenance pointers and review packets only",
    "artifact_mode": "immutable_review_copy",
    "max_artifact_files": 50,
    "max_artifact_total_bytes": 268435456,
    "max_single_artifact_bytes": 134217728,
    "blocked_artifact_patterns": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "id_rsa*",
      "credentials*.json",
      "token*.json",
      "*.p12",
      "*.pfx"
    ],
    "workbooks_mutable": false
  },
  "go_review": {
