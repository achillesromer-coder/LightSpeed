    "decision_path": "Z Axis/Z-4_Merovingian/data/runtime_exports/go_review_decisions.jsonl",
    "require_owner_gate": true,
    "active_owner_approval_ref": "operator_canonical_consolidation_destructive_progress_2026_08_14",
    "allowed_decisions": [
      "approve",
      "hold",
      "reject"
    ],
    "private_local_projection": true,
    "identity_index": {
