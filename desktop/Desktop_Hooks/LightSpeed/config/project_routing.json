      "required_operator_shell": "D:\\LightSpeed\\App",
      "database_authority": "config/launch_control.json#canonical_authorities.database",
      "source_table": "immutable_jsonl_index_sources",
      "offset_table": "immutable_jsonl_identity_offsets",
      "stores_full_payloads": false,
      "scan_bytes_per_cycle": 8388608,
      "fallback_memory_identity_limit": 4096
    }
  },
  "cleanup_policy": {
