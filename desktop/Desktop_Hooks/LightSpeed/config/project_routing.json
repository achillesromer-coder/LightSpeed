  "canonical_sources": {
    "drive": {
      "role": "canonical knowledge, evidence, reviewed workbooks and owner assets",
      "promotion_rule": "stable identity plus source revision/hash plus lineage/readback receipt"
    },
    "git": {
      "role": "operational code, topology, schemas, manifests, receipts and web/platform integration links",
      "repository_visibility": "public",
      "private_payloads_allowed": false
    },
    "local": {
      "role": "execution runtime, bounded working state, cache and staging",
      "installed_shell_last_verified": "D:\\LightSpeed\\App",
      "canonical_without_receipt": false
    },
    "recovery": {
      "role": "recovery/reference evidence",
      "promotion_rule": "reconcile exact hash, source lineage and current Drive/Git authority before use"
    }
  },
  "startup_materialization": {
    "mode": "reference_first",
    "new_project_policy": "register stable identity and canonical pointers first; materialise writable local state only when execution requires it",
    "new_agent_policy": "reuse the existing floor runtime and shared canonical pointers; do not clone source/project payloads into Agents, Z Direct, X, Y or Z trees",
    "create_if_missing_only": [
      "required runtime directories",
      "one canonical project identity record for an explicitly created project",
      "queue or receipt ledger only when the ledger does not already exist"
    ],
    "never_duplicate_for_convenience": [
      "canonical workbooks",
      "owner CAD/source assets",
      "project payloads",
      "database snapshots",
      "agent/floor mirrors"
    ],
    "task_source_lock": "resolve current Drive revision/hash and Git commit before heavy execution"
  },
  "project_roots": [
    {
      "root_id": "projects-canonical",
      "path": "Projects",
      "authority": "canonical_runtime_pointer",
      "writable": true,
      "desktop_visible": true
    },
    {
      "root_id": "architect-legacy",
      "path": "Z Axis/Z+1_Architect/projects",
      "authority": "legacy_reference",
      "writable": false,
      "desktop_visible": true
    },
    {
      "root_id": "construct-legacy",
      "path": "Z Axis/Z0_TheConstruct/projects",
