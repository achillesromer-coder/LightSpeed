{
  "version": 2,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/cgx/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors https://romer.industries https://www.romer.industries"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Cgx",
      "destination": "/cgx",
      "permanent": true
    },
    {
      "source": "/Cgx/:path*",
      "destination": "/cgx/:path*",
      "permanent": true
    }
  ]
}
