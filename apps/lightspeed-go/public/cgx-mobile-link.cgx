{
  "schema": "cgx.ls-go.mobile-link/1",
  "purpose": "Bounded mobile-to-desktop bootstrap, not a CGX runtime",
  "operator_ui": "https://lightspeed-go.nathaniel-b.chatgpt.site/",
  "mobile_role": "roaming_operator",
  "host_node": "bouwerbase",
  "bridge": {
    "source": "existing_lightspeed_go_desktop_bridge",
    "origin_config": "VITE_LIGHTSPEED_DESKTOP_ORIGIN",
    "local_only_origin": "http://127.0.0.1:8765",
    "remote_transport": "owner_selected_private_https_relay",
    "discovery": "configured_origin_only",
    "probe": "GET /api/v1/status",
    "owner_sign_in": "POST /api/v1/auth/login"
  },
  "exchange": {
    "commands": "existing_achilles_gated_ls_go_envelopes",
    "results": "existing_desktop_receipts",
    "source_code": "github_lightspeed",
    "durable_evidence": "drive_core_asynchronous"
  },
  "constraints": {
    "embedded_credentials": false,
    "public_direct_execution": false,
    "automatic_owner_approval": false,
    "new_backend": false,
    "cgx_backscatter": false,
    "fail_closed_on_missing_relay_or_auth": true
  },
  "release_gate": "require_verified_phone_to_private_relay_to_live_desktop_receipt"
}
