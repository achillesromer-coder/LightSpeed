{
  "schema": "cgx.ls-go.mobile-link/1",
  "purpose": "Bounded CGX roaming-node discovery and handoff, not a separate CGX runtime",
  "operator_ui": "https://lightspeed-go.nathaniel-b.chatgpt.site/",
  "mobile_role": "roaming_operator",
  "host_node": "bouwerbase",
  "bridge": {
    "source": "existing_owner_private_ls_go_site",
    "local_only_origin": "http://127.0.0.1:8765",
    "remote_transport": "existing_owner_private_ls_go_site",
    "discovery": "existing_site_same_origin",
    "probe": "GET /api/v1/status",
    "owner_sign_in": "existing_site_owner_auth"
  },
  "exchange": {
    "commands": "existing_achilles_gated_ls_go_envelopes",
    "results": "existing_desktop_receipts",
    "source_code": "github_lightspeed",
    "durable_evidence": "drive_core_asynchronous",
    "transport_priority": [
      "existing_owner_private_ls_go_site",
      "owner_authorised_drive_mailbox_on_bridge_failure"
    ],
    "intake": "bounded_cgx_request_envelope_v1",
    "capability_assessment": "bouwerbase_declared_capability_and_dependency_match",
    "assessment_states": [
      "can_do",
      "can_do_when_ready",
      "unsupported",
      "held"
    ],
    "assessment_receipt": "typed_local_readback_with_capability_id_missing_dependencies_and_authority_state",
    "action_rule": "can_do_means_capable_only; execution requires a current scoped lease or owner-approved authority",
    "command_execution": "existing_achilles_gated_ls_go_envelopes_via_local_runtime",
    "fallback": "drive_mailbox_is_an_untrusted_transport_not_execution_authority",
    "local_dbr": "primary_authoritative_execution_receipt_on_bouwerbase",
    "drive_dbr": "asynchronous_backup_only_after_hash_and_identity_readback",
    "change_detection": "compare_object_revision_and_sha256; only transfer changed_identifiers_or_approved_payloads",
    "site_transport": "bounded_host_report_and_untrusted_owner_intent_only; local acceptance/session/lease/result remain separate"
  },
  "constraints": {
    "embedded_credentials": false,
    "public_direct_execution": false,
    "automatic_owner_approval": false,
    "new_backend": false,
    "cgx_backscatter": false,
    "fail_closed_on_missing_relay_or_auth": true,
    "drive_write_grants_local_execution": false,
    "capability_match_grants_local_execution": false,
    "preserve_local_owner_gates": true,
    "allow_scoped_preapproved_local_work": true,
    "no_automatic_replay_of_unacknowledged_jobs": true,
    "idempotent_envelopes_by_request_id": true,
    "no_unauthorised_local_path_resolution": true,
    "new_mobile_runtime": false,
    "authority_by_device": false,
    "transfer_full_corpus_on_open": false,
    "drive_write_grants_execution": false
  },
  "release_gate": "source_only_until_bouwerbase_capability_assessment_authorised_action_and_exact_dbr_readback_verified",
  "semantic_root": "cgx://cgx.cgx",
  "kind": "CGX-MOBILE-BOOTSTRAP/0.1",
  "binding": "CGX-MOBILE-NODE-BINDING/0.1",
  "protocol_chain": [
    "CGX-MOBILE-BOOTSTRAP/0.1",
    "CGX-DEVICE-HANDSHAKE/0.1",
    "CGX-NODE-EXCHANGE-CONTRACT/0.1"
  ]
}
