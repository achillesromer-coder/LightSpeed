{
  "name": "lightspeed-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism && node --test scripts/checkCgxMobileCccSourceGate.mjs scripts/checkCgxLoadSemanticReview.mjs scripts/checkCgxUnifiedBootstrapReview.mjs",
    "check:cgx-ccc-mobile": "node --test scripts/checkCgxMobileCccSourceGate.mjs",
    "check:cgx-load-semantic": "node --test scripts/checkCgxLoadSemanticReview.mjs",
    "check:cgx-bootstrap-review": "node --test scripts/checkCgxUnifiedBootstrapReview.mjs"
  },
  "dependencies": {
    "typescript": "^5.7.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
