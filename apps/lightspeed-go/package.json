{
  "name": "lightspeed-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ./scripts/checkPublicRelease.mjs --phase source && npm run build:internal && node ./scripts/checkPublicRelease.mjs --phase dist",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run src --pool=threads --maxWorkers=1 --no-file-parallelism",
    "build:internal": "tsc --noEmit && vite build",
    "build:public": "npm run build",
    "test:release": "node --test ./scripts/checkPublicRelease.test.mjs"
  },
  "dependencies": {
    "typescript": "^5.7.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
